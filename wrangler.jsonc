{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tap-independent-preview",
  "workers_dev": true,
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "tapknows.com/*",
      "zone_name": "tapknows.com",
    },
    {
      "pattern": "www.tapknows.com/*",
      "zone_name": "tapknows.com",
    },
  ],
}
