{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tap-independent-preview",
  "workers_dev": true,
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "tapknows.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.tapknows.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "run_worker_first": true,
  },
}
